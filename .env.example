# Copy to .env and start with ./run.sh. Never commit your .env.
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
DEVICE_TOKEN=replace-with-a-unique-device-secret
DB_PATH=videotron.db

# Local test switches; ignored when APP_ENV=production.
# ENABLE_DEMO_OTP affects PHONE only. EMAIL always uses configured SMTP.
ENABLE_DEMO_OTP=false
ENABLE_DEMO_PAYMENTS=false

# Operator identity: complete and review terms before public use.
OPERATOR_NAME=
# Optional business address printed on invoices.
OPERATOR_ADDRESS=
SUPPORT_EMAIL=
# Optional public workspace URL for links in transactional emails.
PUBLIC_BASE_URL=

# Bank transfer checkout, verified manually by the administrator.
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# Email OTP: ssl (implicit TLS, usually 465) or starttls (usually 587).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_ENCRYPTION=ssl
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# HTTPS adapter accepting {"to":"+62...","code":"123456","expires_in":300}.
PHONE_OTP_WEBHOOK_URL=
PHONE_OTP_WEBHOOK_TOKEN=

# Set true when running python scheduler.py as a separate process.
DISABLE_EMBEDDED_SCHEDULER=false
HOST=127.0.0.1
PORT=8000
