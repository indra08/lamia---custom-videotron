{
  "name": "lamia-cloudflare",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "import:env": "node scripts/import-env.mjs",
    "build:pages": "node scripts/prepare-pages.mjs",
    "predeploy:pages": "npm test && npm run build:pages && node scripts/check-deploy.mjs",
    "deploy:pages": "wrangler pages deploy --cwd .generated/pages --branch main --commit-dirty=true",
    "prebuild": "npm run prepare:assets",
    "pretest": "node scripts/prepare-fonts.mjs",
    "test": "node --test tests/*.test.mjs",
    "predev": "npm run prepare:assets",
    "build": "wrangler deploy --dry-run --config .generated/wrangler.json",
    "dev": "wrangler dev --config .generated/wrangler.json",
    "predeploy": "npm test && npm run build && node scripts/check-deploy.mjs",
    "deploy": "wrangler deploy --config .generated/wrangler.json --secrets-file .secrets.json",
    "migrate:local": "wrangler d1 migrations apply DB --local --config .generated/wrangler.json",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config .generated/wrangler.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:env": "node scripts/smoke.mjs --source-env"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.130.0"
  }
}
